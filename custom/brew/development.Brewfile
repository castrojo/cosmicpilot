# Development tools Brewfile
# Tools for developers and engineers

# Version Control
brew "git"
brew "gh"         # GitHub CLI

# Programming Languages
brew "python"
brew "node"
brew "go"

# Build Tools
brew "cmake"
brew "make"

# Code Quality
brew "shellcheck"  # Shell script linter

# Utilities
brew "jq"         # JSON processor
brew "yq"         # YAML processor
brew "httpie"     # HTTP client
